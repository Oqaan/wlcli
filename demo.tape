# Demo GIF for the README.
# Requires vhs, ttyd and ffmpeg. Regenerate with: vhs demo.tape

Output demo.gif

Set Shell "bash"
Set FontSize 18
Set Width 800
Set Height 580
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 75ms

Sleep 500ms
Type "wlcli -d schwedenplatz"
Sleep 500ms
Enter
Sleep 6s
