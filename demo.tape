# Demo GIF for the README.
# Requires vhs, ttyd and ffmpeg. Regenerate with: vhs demo.tape

Output demo.gif

Set Shell "bash"
Set FontSize 18
Set Width 760
Set Height 520
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 75ms

Sleep 500ms
Type "wlcli schwedenplatz"
Sleep 500ms
Enter
Sleep 6s
